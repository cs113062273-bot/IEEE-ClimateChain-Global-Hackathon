FROM node:24-slim AS chain
WORKDIR /chain/contracts
COPY contracts/package.json contracts/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY contracts/scripts ./scripts
COPY contracts/public ./public

FROM python:3.11-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 libstdc++6 && rm -rf /var/lib/apt/lists/*
COPY requirements.txt requirements.lock.txt ./
RUN pip install --no-cache-dir -r requirements.lock.txt
COPY backend ./backend
COPY scripts ./scripts
COPY data/sample ./data/sample
COPY data/trust ./data/trust
COPY data/manifests ./data/manifests
COPY experiments ./experiments
COPY --from=chain /usr/local/bin/node /usr/local/bin/node
COPY --from=chain /chain/contracts ./contracts
ENV GRIDPROOF_ALLOW_CHAIN_WRITES=0 GRIDPROOF_READ_ONLY=1 GRIDPROOF_STORAGE_PATH=/tmp/gridproof/runs.sqlite3 PORT=8000
EXPOSE 8000
CMD ["sh", "-c", "uvicorn backend.app.main:app --host 0.0.0.0 --port ${PORT}"]
