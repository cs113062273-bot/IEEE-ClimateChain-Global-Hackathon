GRIDPROOF_API_URL=http://127.0.0.1:8000
GRIDPROOF_LOCAL_RPC_URL=http://127.0.0.1:8545
GRIDPROOF_CHAIN_ID=31337
GRIDPROOF_CHAIN_NETWORK=local
# Public hosted services must enable read-only mode; local deliberate writes need 0.
GRIDPROOF_READ_ONLY=1
GRIDPROOF_ALLOW_CHAIN_WRITES=0
# Optional Sepolia read-only configuration, chain ID 11155111. No deployment exists yet.
GRIDPROOF_SEPOLIA_RPC_URL=
GRIDPROOF_SEPOLIA_DEPLOYMENT_FILE=contracts/public/sepolia-registry.json
GRIDPROOF_PUBLIC_PROOF_FILE=contracts/public/fixed-proof.json
# Dedicated test-only signer: operator CLI only. Never NEXT_PUBLIC/API/request input.
# Leave empty in hosted verification services; no public broadcast command is enabled.
GRIDPROOF_SEPOLIA_PRIVATE_KEY=
